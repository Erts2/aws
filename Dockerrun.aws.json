{
  "AWSEBDockerrunVersion": "2",
  "containerDefinitions": [
    {
      "name": "client",
      "image": "erts2/multi-client",
      "hostname": "client",
      "essential": false,
      "memory": 128
    },
    {
      "name": "server",
      "image": "erts2/multi-server",
      "hostname": "api",
      "essential": false,
      "memory": 128
    },
    {
      "name": "worker",
      "image": "erts2/multi-worker",
      "hostname": "worker",
      "essential": false,
      "memory": 128
    },
    {
        "name": "nginx",
        "image": "erts2/multi-nginx",
        "essential": true,
        "portMappings": [
          {
            "containerPort": 80,
            "hostPort": 80
          }
        ],
        "memory": 128
        "links": ["client", "server"]
    }
  ]
}